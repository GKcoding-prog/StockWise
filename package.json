{
  "name": "stockwise",
  "private": true,
  "description": "StockWise — Smart Inventory Management and Decision Support System for SMEs",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @stockwise/shared build && pnpm --parallel --filter @stockwise/api --filter @stockwise/web --filter @stockwise/shared dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @stockwise/api test:e2e",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "pnpm --filter @stockwise/api db:init",
    "db:migrate": "pnpm --filter @stockwise/api db:migrate",
    "db:seed": "pnpm --filter @stockwise/api db:seed",
    "db:reset": "pnpm --filter @stockwise/api db:reset",
    "db:studio": "pnpm --filter @stockwise/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
