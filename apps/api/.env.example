# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=3000

# Matches docker-compose.yml
DATABASE_URL=postgresql://stockwise:stockwise@localhost:5432/stockwise

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Generate long random values, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars

# Mailpit (docker compose) catches all emails: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="StockWise <no-reply@stockwise.local>"

# Public URL of the web app (used in email links)
APP_URL=http://localhost:5173
