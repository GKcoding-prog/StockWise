# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://stockwise:stockwise@localhost:5433/stockwise
# Used by the API test suites (created by docker/postgres-init.sql)
TEST_DATABASE_URL=postgresql://stockwise:stockwise@localhost:5433/stockwise_test

# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Comma-separated list of allowed browser origins (CORS + Origin check on cookie routes)
WEB_ORIGINS=http://localhost:5173
# Public URL of the web app, used in emailed links
WEB_URL=http://localhost:5173

# Mailpit in development (web UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="StockWise <no-reply@stockwise.local>"
